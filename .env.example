# ------------------------------------------------------------------
# Copiá este archivo como .env.local y completá los valores.
# .env.local está en .gitignore y NUNCA se sube al repositorio.
#
# REGLA DE ORO: todo lo que empieza con VITE_ termina publicado en el
# JavaScript que descarga el visitante. Poné acá SOLO datos públicos.
# Un token de escritura de Sanity, una API key de correo o cualquier
# secreto va en una variable SIN el prefijo VITE_, del lado del servidor.
# ------------------------------------------------------------------

# --- CMS (Sanity) -------------------------------------------------
# Ambos son públicos y de solo lectura. Los ves en sanity.io/manage.
# Si los dejás vacíos, el sitio funciona con productos de ejemplo.
VITE_SANITY_PROJECT_ID=pbfa14to
VITE_SANITY_DATASET=production

# --- Formulario de contacto (Web3Forms) ---------------------------
# Access key gratuita de https://web3forms.com — se pide con el correo
# donde querés recibir las solicitudes. Es pública por diseño: sólo
# sirve para enviar a ESE correo. Si la dejás vacía, el formulario
# queda en modo demostración.
VITE_WEB3FORMS_KEY=

# --- Captcha (Cloudflare Turnstile) — opcional --------------------
# Site key de https://dash.cloudflare.com (Turnstile). Es pública.
# Si la dejás vacía, no se carga nada de Cloudflare y el formulario
# se defiende con honeypot + trampa de tiempo + límites de longitud.
VITE_TURNSTILE_SITE_KEY=
